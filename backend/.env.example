# LogicForge Environment Configuration

# Database
# Default: SQLite for immediate local development
DATABASE_URL=sqlite:///./logicforge.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql://logicforge_user:logicforge_password@localhost:5432/logicforge_db

# JWT Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Generative AI Provider (Primary: Google Gemini)
# Configure your Google Gemini API key to enable live model reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Generative AI Failover / Fallback Provider (Groq Cloud)
# High-speed low-latency fallback when Gemini is unavailable, rate-limited, or errors
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Code Execution Sandbox
SANDBOX_ENABLED=true
EXECUTION_TIMEOUT_SECONDS=5
MAX_OUTPUT_BYTES=10240

# Server
PORT=8000
HOST=0.0.0.0
